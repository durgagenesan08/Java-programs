import java.applet.Applet;
import java.awt.*;
import java.awt.event.*;
class Machine {
    String name;
    String status = "STOPPED";
    int productionCount = 0;
    Thread thread;
    boolean running = false;
    boolean paused = false;

    Machine(String name) {
        this.name = name;
    }
    synchronized void start() {
        if (status.equals("RUNNING")) return;
        running = true;
        paused = false;
        status = "RUNNING";
        if (thread == null ||!thread.isAlive()) {
            thread = new Thread(() -> {
                while (running) {
                    try {
                        if (!paused) {
                            productionCount++;
                        }
                        Thread.sleep(1000);
                    } catch (InterruptedException e) {}
                }
            });
            thread.start();
        }
    }
    synchronized void stop() {
        if (status.equals("STOPPED")) return;
        status = "STOPPED";
        running = false;
        paused = false;
        thread = null;
    }
    synchronized void pause() {
        if (!status.equals("RUNNING")) return;
        status = "PAUSED";
        paused = true;
    }
    synchronized void reset() {
        stop();
        productionCount = 0;
        status = "STOPPED";
    }
}
public class Main extends Applet implements ActionListener, ItemListener {
    Machine[] machines = { new Machine("Machine-1"), new Machine("Machine-2"), new Machine("Machine-3") };
    Machine selectedMachine = machines[0];
    Choice machineChoice;
    Label statusLabel, countLabel, msgLabel;
    Button startBtn, stopBtn, pauseBtn, resetBtn;
    Panel controlPanel, displayPanel;
    TextArea reportArea;
    public void init() {
        setLayout(new BorderLayout());
        MenuBar mb = new MenuBar();
        Menu machineMenu = new Menu("Machine Selection");
        Menu monitorMenu = new Menu("Monitoring");
        Menu reportMenu = new Menu("Report");
        for (Machine m : machines) {
            MenuItem mi = new MenuItem(m.name);          mi.addActionListener(this);
            machineMenu.add(mi);
        }
        MenuItem refreshItem = new MenuItem("Refresh Status");
        MenuItem genReportItem = new MenuItem("Generate Report");      refreshItem.addActionListener(this);      genReportItem.addActionListener(this);      monitorMenu.add(refreshItem);      reportMenu.add(genReportItem);
        mb.add(machineMenu);
        mb.add(monitorMenu);
        mb.add(reportMenu);
        Panel topPanel = new Panel(new FlowLayout());
        topPanel.add(new Label("Select Machine:"));
        machineChoice = new Choice();
        for (Machine m : machines) machineChoice.add(m.name); machineChoice.addItemListener(this);
        topPanel.add(machineChoice);
        displayPanel = new Panel(new GridLayout(3, 1));
        statusLabel = new Label("Status: STOPPED", Label.CENTER);
        countLabel = new Label("Production: 0", Label.CENTER);
        msgLabel = new Label("Ready", Label.CENTER);
        statusLabel.setFont(new Font("Arial", Font.BOLD, 14)); displayPanel.add(statusLabel);  displayPanel.add(countLabel);
        displayPanel.add(msgLabel);
        controlPanel = new Panel(new FlowLayout());
        startBtn = new Button("Start");
        stopBtn = new Button("Stop");
        pauseBtn = new Button("Pause");
        resetBtn = new Button("Reset");      startBtn.addActionListener(this);       stopBtn.addActionListener(this);      pauseBtn.addActionListener(this);     resetBtn.addActionListener(this);
        controlPanel.add(startBtn);
        controlPanel.add(pauseBtn);
        controlPanel.add(stopBtn);
        controlPanel.add(resetBtn);
        reportArea = new TextArea(5, 40);       reportArea.setEditable(false);
        add(topPanel, BorderLayout.NORTH);
        add(displayPanel, BorderLayout.CENTER);
        add(controlPanel, BorderLayout.SOUTH);
        add(reportArea, BorderLayout.EAST);
        new Thread(() -> {
            while (true) {
                updateDisplay();
                try { Thread.sleep(500); } catch (Exception e) {}
            }
        }).start();
    }
    public void updateDisplay() {
        statusLabel.setText("[" + selectedMachine.name + "] Status: " + selectedMachine.status);       countLabel.setText("Production: " + selectedMachine.productionCount);
        startBtn.setEnabled(!selectedMachine.status.equals("RUNNING"));       pauseBtn.setEnabled(selectedMachine.status.equals("RUNNING"));
        stopBtn.setEnabled(!selectedMachine.status.equals("STOPPED"));
    }
    public void actionPerformed(ActionEvent ae) {
        String cmd = ae.getActionCommand();
        if (cmd.equals("Start")) {
            if (selectedMachine.status.equals("RUNNING")) {              msgLabel.setText("Error: Already Running!");
            } else {               selectedMachine.start();              msgLabel.setText(selectedMachine.name + " Started");
            }
        } else if (cmd.equals("Stop")) {
            if (selectedMachine.status.equals("STOPPED")) {               msgLabel.setText("Error: Already Stopped!");
            } else {               selectedMachine.stop();               msgLabel.setText(selectedMachine.name + " Stopped");
            }
        } else if (cmd.equals("Pause")) {
            if (!selectedMachine.status.equals("RUNNING")) {               msgLabel.setText("Error: Can only pause running machine!");
            } else {               selectedMachine.pause();               msgLabel.setText(selectedMachine.name + " Paused");
            }
        } else if (cmd.equals("Reset")) {
            selectedMachine.reset();
            msgLabel.setText(selectedMachine.name + " Reset Done");
        } else if (cmd.equals("Generate Report")) {
            generateReport();
        } else if (cmd.equals("Refresh Status")) {
            updateDisplay();
        } else {
            for (Machine m : machines) {
                if (m.name.equals(cmd)) {
                    selectedMachine = m;
                    machineChoice.select(m.name);
                    msgLabel.setText("Switched to " + m.name);
                }
            }
        }
        updateDisplay();
    }
    public void itemStateChanged(ItemEvent ie) {
        String selected = machineChoice.getSelectedItem();
        for (Machine m : machines) {
            if (m.name.equals(selected)) {
                selectedMachine = m;
                break;
            }
        }
        updateDisplay();
    }
    void generateReport() {
        StringBuilder sb = new StringBuilder("--- PRODUCTION REPORT ---\n");
        for (Machine m : machines) {
            sb.append(m.name).append(" | Status: ").append(m.status)
           .append(" | Count: ").append(m.productionCount).append("\n");
        }  reportArea.setText(sb.toString());
    }
}