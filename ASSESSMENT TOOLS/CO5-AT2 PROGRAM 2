import java.io.*;
import java.util.*;
import java.sql.*;

class Main {
    private static HashMap<Integer, Customer> customerDB = new HashMap<>();
    private static ByteArrayOutputStream transactionLog = new ByteArrayOutputStream();
    private static byte[] backupData = null;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNext()) {
            sc.close();
            return;
        }
        String op = sc.next().toLowerCase();
        try {
            switch (op) {
                case "create":
                case "insert":
                case "add":
                    int id = sc.nextInt();
                    String name = sc.next();
                    double bal = sc.nextDouble();
                    insertCustomer(id, name, bal);
                    break;
                case "deposit":
                    int did = sc.nextInt();
                    double damt = sc.nextDouble();
                    deposit(did, damt);
                    break;
                case "withdraw":
                    int wid = sc.nextInt();
                    double wamt = sc.nextDouble();
                    withdraw(wid, wamt);
                    break;
                case "balance":
                case "select":
                    int sid = sc.nextInt();
                    selectCustomer(sid);
                    break;
                case "update":
                    int uid = sc.nextInt();
                    String uname = sc.next();
                    updateCustomer(uid, uname);
                    break;
                case "delete":
                    int delid = sc.nextInt();
                    deleteCustomer(delid);
                    break;
            }
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
        sc.close();
    }

    public static void insertCustomer(int id, String name, double balance) {
        try {
            if (customerDB.containsKey(id)) {
                throw new Exception("Customer ID already exists");
            }
            if (balance < 0) {
                throw new Exception("Invalid initial balance");
            }
            Customer c = new Customer(id, name, balance);
            customerDB.put(id, c);
            logTransaction("INSERT Customer " + id);
            backupCustomers();
            simulateJDBCInsert(id, name, balance);
            System.out.println("Customer created successfully: " + c);
        } catch (Exception e) {
            System.out.println("Database Error: " + e.getMessage());
        }
    }

    public static void deposit(int id, double amount) {
        try {
            Customer c = customerDB.get(id);
            if (c == null) throw new Exception("Customer not found");
            if (amount <= 0) throw new Exception("Invalid amount");
            c.balance += amount;
            logTransaction("DEPOSIT " + id + " Amount " + amount);
            backupCustomers();
            simulateJDBCUpdate(id, c.balance);
            System.out.println("Deposit successful. New Balance: " + c.balance);
        } catch (Exception e) {
            System.out.println("Transaction Error: " + e.getMessage());
        }
    }

    public static void withdraw(int id, double amount) {
        try {
            Customer c = customerDB.get(id);
            if (c == null) throw new Exception("Customer not found");
            if (amount <= 0) throw new Exception("Invalid amount");
            if (c.balance < amount) throw new Exception("Insufficient funds");
            c.balance -= amount;
            logTransaction("WITHDRAW " + id + " Amount " + amount);
            backupCustomers();
            simulateJDBCUpdate(id, c.balance);
            System.out.println("Withdrawal successful. New Balance: " + c.balance);
        } catch (Exception e) {
            System.out.println("Transaction Error: " + e.getMessage());
        }
    }

    public static void selectCustomer(int id) {
        try {
            Customer c = customerDB.get(id);
            if (c == null) throw new Exception("Customer not found");
            System.out.println("Customer Found: " + c);
        } catch (Exception e) {
            System.out.println("Database Error: " + e.getMessage());
        }
    }

    public static void updateCustomer(int id, String newName) {
        try {
            Customer c = customerDB.get(id);
            if (c == null) throw new Exception("Customer not found");
            c.name = newName;
            logTransaction("UPDATE Customer " + id);
            backupCustomers();
            System.out.println("Customer updated successfully: " + c);
        } catch (Exception e) {
            System.out.println("Database Error: " + e.getMessage());
        }
    }

    public static void deleteCustomer(int id) {
        try {
            if (!customerDB.containsKey(id)) throw new Exception("Customer not found");
            customerDB.remove(id);
            logTransaction("DELETE Customer " + id);
            backupCustomers();
            System.out.println("Customer deleted successfully");
        } catch (Exception e) {
            System.out.println("Database Error: " + e.getMessage());
        }
    }

    public static void logTransaction(String msg) {
        try {
            transactionLog.write((msg + "\n").getBytes());
        } catch (IOException e) {
            System.out.println("I/O Error: " + e.getMessage());
        }
    }

    public static void backupCustomers() {
        try {
            ByteArrayOutputStream baos = new ByteArrayOutputStream();
            ObjectOutputStream oos = new ObjectOutputStream(baos);
            oos.writeObject(customerDB);
            oos.close();
            backupData = baos.toByteArray();
        } catch (IOException e) {
            System.out.println("I/O Error: Backup failed - " + e.getMessage());
        }
    }

    @SuppressWarnings("unchecked")
    public static void restoreBackup() {
        try {
            if (backupData == null) return;
            ByteArrayInputStream bais = new ByteArrayInputStream(backupData);
            ObjectInputStream ois = new ObjectInputStream(bais);
            customerDB = (HashMap<Integer, Customer>) ois.readObject();
            ois.close();
        } catch (Exception e) {
            System.out.println("I/O Error: Restore failed");
        }
    }

    public static void simulateJDBCInsert(int id, String name, double bal) {
        try {
            Connection con = null;
            PreparedStatement ps = null;
            String query = "INSERT INTO customers VALUES(?,?,?)";
            if (con == null) throw new SQLException("Simulated JDBC - Connection not available in lab");
        } catch (SQLException e) {
        }
    }

    public static void simulateJDBCUpdate(int id, double bal) {
        try {
            Connection con = null;
            Statement st = null;
            String query = "UPDATE customers SET balance=" + bal + " WHERE id=" + id;
            if (con == null) throw new SQLException("Simulated JDBC");
        } catch (SQLException e) {
        }
    }
}

class Customer implements Serializable {
    private static final long serialVersionUID = 1L;
    int id;
    String name;
    double balance;

    Customer(int id, String name, double balance) {
        this.id = id;
        this.name = name;
        this.balance = balance;
    }

    public String toString() {
        return "ID: " + id + ", Name: " + name + ", Balance: " + balance;
    }
}